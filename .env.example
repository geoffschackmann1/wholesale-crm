# Supabase / Postgres
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Supabase (for auth in apps/web)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (Module 3)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# BatchData (Module 3)
BATCHDATA_API_KEY=

# Inngest (Module 3+)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

ALERT_PHONE_NUMBER=+1xxxxxxxxxx

# Web Push (Module 4 — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PUSH_SUBSCRIPTION=

# Sentry (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
